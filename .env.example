# ==============================================================================
# BIDSURE.AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API keys
# ==============================================================================

PORT=3001

# ─── 1. Google Gemini AI (Multimodal OCR & Document Intelligence) ─────────────
# Portal: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── 2. DigiLocker / Meri Pehchaan Requester API (Spec v2.4) ─────────────────
# Portal: https://partners.digitallocker.gov.in/ or https://meripehchaan.gov.in/
DIGILOCKER_CLIENT_ID=YOUR_DIGILOCKER_CLIENT_ID_HERE
DIGILOCKER_CLIENT_SECRET=YOUR_DIGILOCKER_CLIENT_SECRET_HERE
DIGILOCKER_REDIRECT_URI=http://localhost:5173/auth/digilocker/callback
DIGILOCKER_BASE_URL=https://digilocker.meripehchaan.gov.in

# ─── 3. GSTN Portal API ───────────────────────────────────────────────────────
# Portal: https://developer.gst.gov.in/ or Sandbox: https://sandbox.gst.gov.in/
GSTN_API_KEY=YOUR_GSTN_API_KEY_HERE
GSTN_BASE_URL=https://api.gst.gov.in/commonapi/v1.1

# ─── 4. MCA21 / Ministry of Corporate Affairs ────────────────────────────────
# Portal: https://data.gov.in/
DATA_GOV_API_KEY=YOUR_DATA_GOV_IN_API_KEY_HERE
DATA_GOV_BASE_URL=https://api.data.gov.in

# ─── 5. Udyam MSME Verification API ──────────────────────────────────────────
# Portal: https://udyamregistration.gov.in/
UDYAM_API_KEY=YOUR_UDYAM_API_KEY_HERE
UDYAM_BASE_URL=https://api.udyamregistration.gov.in

# ─── 6. Commercial Credit & CIBIL Bureau ─────────────────────────────────────
# Portal: https://finbox.in/ or https://crifhighmark.com/developer/
CREDIT_API_KEY=YOUR_CREDIT_BUREAU_API_KEY_HERE
CREDIT_BASE_URL=https://api.finbox.in

# ─── 7. Google Cloud Vision API (Optional) ───────────────────────────────────
# Portal: https://console.cloud.google.com/
GOOGLE_CLOUD_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY_HERE
